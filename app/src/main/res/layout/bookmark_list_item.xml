<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginStart="@dimen/chrome_inner_margin"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="@dimen/chrome_inner_margin"
    android:layout_marginBottom="4dp"
    android:background="?attr/listBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/faviconBookmark"
        android:layout_width="@dimen/material_grid_small_icon"
        android:layout_height="@dimen/material_grid_small_icon"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/textBookmark"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:minHeight="?android:attr/listPreferredItemHeightSmall"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.Solipsism.RowPrimary" />

    <FrameLayout
        android:id="@+id/dragHandleBookmark"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/bookmark_reorder_handle">

        <View
            android:layout_width="4dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:background="@drawable/bookmark_drag_pill" />

    </FrameLayout>

</LinearLayout>
